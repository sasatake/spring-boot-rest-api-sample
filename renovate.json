{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled"
  ],
  "timezone": "Asia/Tokyo",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Spring Boot プラグインと BOM 管理プラグインは足並みを揃える必要があるので 1 PR にまとめる",
      "groupName": "Spring Boot",
      "groupSlug": "spring-boot",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "org.springframework.boot**",
        "io.spring.dependency-management**"
      ]
    },
    {
      "description": "静的解析・カバレッジのツール群。build.gradle の toolVersion は gradle manager が標準で解決する",
      "groupName": "静的解析ツール",
      "groupSlug": "static-analysis",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "com.github.spotbugs**",
        "com.puppycrawl.tools:checkstyle",
        "net.sourceforge.pmd:pmd-java",
        "org.jacoco:jacoco"
      ]
    },
    {
      "description": "GitHub Actions と Docker イメージは minor/patch をまとめる",
      "groupName": "CI / コンテナイメージ",
      "groupSlug": "ci-images",
      "matchManagers": ["github-actions", "docker-compose", "devcontainer"],
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "description": "Gradle Wrapper は単独 PR。CI が通れば安全に取り込める",
      "groupName": "Gradle Wrapper",
      "groupSlug": "gradle-wrapper",
      "matchManagers": ["gradle-wrapper"]
    }
  ]
}
